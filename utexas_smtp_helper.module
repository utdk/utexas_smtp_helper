<?php

/**
 * @file
 * Primary module hooks for utexas_smtp_helper.
 */

/**
 * Implements hook_form_FORM_ID_alter() for utexas_general_config.
 */
function utexas_smtp_helper_form_utexas_general_config_alter(&$form, $form_state, $form_id) {
  // We allow static calls to services.
  // phpcs:ignore
  $opt_in_smtp = \Drupal::state()->get('utexas_smtp', 0);
  $form['smtp_settings'] = [
    '#title' => 'SMTP',
    '#type' => 'fieldset',
  ];
  $form['smtp_settings']['utexas_smtp'] = [
    '#type' => 'checkbox',
    '#title' => t('Use UTDK SMTP service'),
    '#description' => t('When enabled, SMTP credentials (host, port, protocol, username, and password) are sourced from the UTDK Pantheon organization secrets instead of being stored in site configuration. Uncheck this if the site uses its own SMTP connection.'),
    '#default_value' => $opt_in_smtp,
  ];
  $form['#submit'][] = 'utexas_smtp_helper_form_utexas_general_config_submit';
}

/**
 * Submit handler for utexas_general_config form.
 */
function utexas_smtp_helper_form_utexas_general_config_submit($form, $form_state) {
  \Drupal::state()->set('utexas_smtp', $form_state->getValue('utexas_smtp'));
}
