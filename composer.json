{
  "name": "utexas/utexas_smtp_helper",
  "type": "drupal-custom-module",
  "description": "Provides a configuration override for SMTP credentials for use with Pantheon Hosting.",
  "keywords": [
    "Drupal"
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "homepage": "https://github.com/utexas-utdk/utexas_smtp_helper",
  "minimum-stability": "dev",
  "support": {
    "issues": "https://github.com/utexas-utdk/utexas_smtp_helper/issues",
    "source": "https://github.com/utexas-utdk/utexas_smtp_helper"
  },
  "require": {
    "drupal/smtp": "^1.4"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "cweagans/composer-patches": true,
      "drupal/core-composer-scaffold": true,
      "composer/installers": true,
      "oomphinc/composer-installers-extender": true
    }
  },
  "prefer-stable": true
}
