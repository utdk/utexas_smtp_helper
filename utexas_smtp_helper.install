<?php

use Drupal\Core\Extension\Requirement\RequirementSeverity;

/**
 * @file
 * Install, update and uninstall functions for the utexas_smtp_helper module.
 */

/**
 * Implements hook_requirements().
 */
function utexas_smtp_helper_requirements($phase) {
  $requirements = [];
  if ($phase === 'install') {
    if (!function_exists('pantheon_get_secret')) {
      $requirements['utexas_smtp_helper_pantheon_secrets'] = [
        'title' => t('Pantheon Secrets'),
        'description' => t('The <code>pantheon_get_secret</code> function is not available. This module requires the Pantheon Secrets API, which is only available on Pantheon hosting environments.'),
        'severity' => RequirementSeverity::Error,
      ];
    }
  }
  return $requirements;
}

/**
 * Implements hook_install().
 */
function utexas_smtp_helper_install() {
  \Drupal::state()->set('utexas_smtp', 1);
  $smtp_config = \Drupal::configFactory()->getEditable('smtp.settings');
  $smtp_config->set('smtp_username', '');
  $smtp_config->set('smtp_password', '');
  $smtp_config->set('smtp_on', '');
  $smtp_config->set('smtp_autotls', '');
  $smtp_config->set('smtp_host', '');
  $smtp_config->set('smtp_port', '');
  $smtp_config->set('smtp_protocol', '');
  $smtp_config->save();
}

/**
 * Implements hook_uninstall().
 */
function utexas_smtp_helper_uninstall() {
  \Drupal::state()->set('utexas_smtp', 0);
}
