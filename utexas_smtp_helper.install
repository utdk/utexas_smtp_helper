<?php

/**
 * @file
 * Install, update and uninstall functions for the utexas_smtp_helper module.
 */

/**
 * Implements hook_install().
 */
function utexas_smtp_helper_install() {
  \Drupal::state()->set('utexas_smtp', 1);
}

/**
 * Enable UTDK service SMTP for sites using service credentials (#1).
 */
function utexas_smtp_helper_update_10001() {
  if (!function_exists('pantheon_get_secret')) {
    return;
  }
  $smtp_config = \Drupal::configFactory()->getEditable('smtp.settings');
  $current_username = $smtp_config->get('smtp_username');
  $current_password = $smtp_config->get('smtp_password');
  $secret_username = pantheon_get_secret('utexas_smtp_username');
  $secret_password = pantheon_get_secret('utexas_smtp_password');
  if (!is_null($secret_username) && $current_username === $secret_username && $current_password === $secret_password) {
    $smtp_config->set('smtp_username', '');
    $smtp_config->set('smtp_password', '');
    $smtp_config->save();
    \Drupal::state()->set('utexas_smtp', 1);
  }
}
